# Allow the active desktop user to query HID battery reports without running as root.
# Uses logind's "uaccess" tag, so access follows the active session and no world-writable
# permissions are needed. The tag grants read AND write on the hidraw node, so it is limited to the
# devices the Linux drivers poll (linux/Makefile.linux DRIVERS; keep both in sync), not every hidraw
# node. Rules match the parent HID device name, BUS:VID:PID.INSTANCE in upper-case hex, which is the
# same for USB and Bluetooth. Reload with: sudo udevadm control --reload-rules && sudo udevadm trigger

# Logitech
SUBSYSTEM=="hidraw", SUBSYSTEMS=="hid", KERNELS=="*:046D:*", TAG+="uaccess"
# Razer
SUBSYSTEM=="hidraw", SUBSYSTEMS=="hid", KERNELS=="*:1532:*", TAG+="uaccess"
# SteelSeries
SUBSYSTEM=="hidraw", SUBSYSTEMS=="hid", KERNELS=="*:1038:*", TAG+="uaccess"
# Corsair
SUBSYSTEM=="hidraw", SUBSYSTEMS=="hid", KERNELS=="*:1B1C:*", TAG+="uaccess"
# Cooler Master
SUBSYSTEM=="hidraw", SUBSYSTEMS=="hid", KERNELS=="*:2516:*", TAG+="uaccess"
# Finalmouse
SUBSYSTEM=="hidraw", SUBSYSTEMS=="hid", KERNELS=="*:361D:*", TAG+="uaccess"
# Glorious / Sinowealth, Hitscan, G-Wolves, WLMouse
SUBSYSTEM=="hidraw", SUBSYSTEMS=="hid", KERNELS=="*:258A:*", TAG+="uaccess"
SUBSYSTEM=="hidraw", SUBSYSTEMS=="hid", KERNELS=="*:3770:*", TAG+="uaccess"
SUBSYSTEM=="hidraw", SUBSYSTEMS=="hid", KERNELS=="*:33E4:*", TAG+="uaccess"
SUBSYSTEM=="hidraw", SUBSYSTEMS=="hid", KERNELS=="*:36A7:*", TAG+="uaccess"
# Kysona / Compx, ATK, Pulsar, HECATE
SUBSYSTEM=="hidraw", SUBSYSTEMS=="hid", KERNELS=="*:3554:*", TAG+="uaccess"
SUBSYSTEM=="hidraw", SUBSYSTEMS=="hid", KERNELS=="*:373B:*", TAG+="uaccess"
SUBSYSTEM=="hidraw", SUBSYSTEMS=="hid", KERNELS=="*:3710:*", TAG+="uaccess"
SUBSYSTEM=="hidraw", SUBSYSTEMS=="hid", KERNELS=="*:35BB:*", TAG+="uaccess"

# The vendor ids below also cover keyboards, printers and other unrelated hardware, so only the
# product ids the drivers know are listed.
